# Host 网络模式下，web 容器连接 MySQL、Redis 时使用的端口。
# 若宿主机端口已被占用，请选择空闲端口，并重启整套 Compose 服务。
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL root 密码与后端数据库连接密码。
# 首次部署前复制本文件为 .env 并按需修改；若数据库已初始化，修改后需同步更新 MySQL root 密码。
MYSQL_ROOT_PASSWORD=123456
SPRING_DATASOURCE_DRUID_PASSWORD=123456

# 追加到 MySQL JDBC URL 的额外参数（不要以 & 开头）。
# 本地 MySQL 8 出现 "Public Key Retrieval is not allowed" 或 SSL 错误时，可设置为：
# SPRING_DATASOURCE_DRUID_EXTRA_ARGS=allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_DRUID_EXTRA_ARGS=

# 可选 MQTT profile；PUBLIC_HOST 填设备可达的 IPv4 或域名，不带协议和端口。
MQTT_PUBLIC_HOST=
MQTT_PORT=1883
MQTT_UDP_PORT=8884
MQTT_API_PORT=8007
# 与智控台 server.mqtt_signature_key 一致，至少 8 位且含大小写字母。
MQTT_SIGNATURE_KEY=
# 与智控台 server.secret 一致。
MQTT_SERVER_SECRET=
MQTT_CHAT_SERVER=ws://host.docker.internal:8000/xiaozhi/v1/?from=mqtt_gateway

KSZ_GUIDE_ENABLED=0
KSZ_MANAGEMENT_API_URL=http://127.0.0.1:14000/api/v1/integration
KSZ_MANAGEMENT_API_TOKEN=
KSZ_GUIDE_CONTROL_URL=
KSZ_GUIDE_CONTROL_TOKEN=
