# Host 网络模式下，web 容器连接 MySQL、Redis 时使用的端口。
# 若宿主机端口已被占用，请选择空闲端口，并重启整套 Compose 服务。
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL root 密码与后端数据库连接密码。
# 首次部署前复制本文件为 .env 并按需修改；若数据库已初始化，修改后需同步更新 MySQL root 密码。
MYSQL_ROOT_PASSWORD=123456
SPRING_DATASOURCE_DRUID_PASSWORD=123456

# 追加到 MySQL JDBC URL 的额外参数（不要以 & 开头）。
# 本地 MySQL 8 出现 "Public Key Retrieval is not allowed" 或 SSL 错误时，可设置为：
# SPRING_DATASOURCE_DRUID_EXTRA_ARGS=allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_DRUID_EXTRA_ARGS=

# 可选 MQTT profile；PUBLIC_HOST 填设备可达的 IPv4 或域名，不带协议和端口。
MQTT_PUBLIC_HOST=
MQTT_PORT=1883
MQTT_UDP_PORT=8884
MQTT_API_PORT=8007
# 与智控台 server.mqtt_signature_key 一致，至少 8 位且含大小写字母。
MQTT_SIGNATURE_KEY=
# 与智控台 server.secret 一致。
MQTT_SERVER_SECRET=
MQTT_CHAT_SERVER=ws://host.docker.internal:8000/xiaozhi/v1/?from=mqtt_gateway

# 场馆导览总开关 / 仅同步在线状态；启用前配置下方 management 地址和令牌。
KSZ_GUIDE_ENABLED=0
KSZ_GUIDE_PRESENCE_ENABLED=0
# 自动讲解总开关，仍需管理端允许该设备自动讲解。
KSZ_GUIDE_AUTO_ANNOUNCE_ENABLED=1
# 首次识别是否讲解；0 只建基准，后续按有效信标 MAC 变化触发。
KSZ_GUIDE_ANNOUNCE_ON_FIRST_BEACON=0
# 切换信标时打断旧信标讲解并跳过本轮冷却；用户对话始终优先。
KSZ_GUIDE_INTERRUPT_ON_BEACON_CHANGE=1
# 播报最小间隔；毫秒，0 关闭冷却。
KSZ_GUIDE_MIN_ANNOUNCE_INTERVAL_MS=15000
# 位置确认 / 待播任务有效期；毫秒，必须大于 0。
KSZ_GUIDE_POSITION_TTL_MS=15000
KSZ_GUIDE_PENDING_TTL_MS=15000
# 停止录音或唤醒检测后的自动讲解静默时间；毫秒，0 关闭额外静默。
KSZ_GUIDE_USER_QUIET_MS=15000

# 信标固定开场，按绑定语言选择；只能包含一个 {location}，空值使用默认模板。
KSZ_GUIDE_LOCATION_TEMPLATE_ZH_CN="您现在位于{location}。"
KSZ_GUIDE_LOCATION_TEMPLATE_EN="You are now at {location}."
KSZ_GUIDE_LOCATION_TEMPLATE_JA="現在、{location}にいます。"
KSZ_GUIDE_LOCATION_TEMPLATE_KO="현재 {location}에 계십니다."

KSZ_MANAGEMENT_API_URL=http://127.0.0.1:14000/api/v1/integration
KSZ_MANAGEMENT_API_TOKEN=
KSZ_GUIDE_CONTROL_URL=
KSZ_GUIDE_CONTROL_TOKEN=
