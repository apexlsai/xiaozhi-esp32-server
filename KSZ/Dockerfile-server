FROM node:18 AS patched-source

WORKDIR /src
COPY main/xiaozhi-server .
COPY KSZ/patches/vision-language-timeout.patch /tmp/vision-language-timeout.patch
RUN git apply --check /tmp/vision-language-timeout.patch \
    && git apply /tmp/vision-language-timeout.patch
COPY KSZ/patches/vision-complete-tts.patch /tmp/vision-complete-tts.patch
RUN git apply --check /tmp/vision-complete-tts.patch \
    && git apply /tmp/vision-complete-tts.patch
COPY KSZ/patches/ksz-prompt.patch /tmp/ksz-prompt.patch
RUN git apply --check /tmp/ksz-prompt.patch \
    && git apply /tmp/ksz-prompt.patch
COPY KSZ/patches/multilingual-sentences.patch /tmp/multilingual-sentences.patch
RUN git apply --check /tmp/multilingual-sentences.patch \
    && git apply /tmp/multilingual-sentences.patch
COPY KSZ/patches/guide-announcement.patch /tmp/guide-announcement.patch
RUN git apply --check /tmp/guide-announcement.patch \
    && git apply /tmp/guide-announcement.patch
COPY KSZ/patches/location-updates.patch /tmp/location-updates.patch
RUN git apply --check /tmp/location-updates.patch \
    && git apply /tmp/location-updates.patch

COPY KSZ/patches/qwen-fun-asr.patch /tmp/qwen-fun-asr.patch
RUN git apply --check /tmp/qwen-fun-asr.patch \
    && git apply /tmp/qwen-fun-asr.patch

COPY KSZ/patches/vision-context.patch /tmp/vision-context.patch
RUN git apply --check /tmp/vision-context.patch \
    && git apply /tmp/vision-context.patch

COPY KSZ/patches/cell-location-server.patch /tmp/cell-location-server.patch
RUN git apply --check /tmp/cell-location-server.patch \
    && git apply /tmp/cell-location-server.patch

COPY KSZ/patches/narration-playback.patch /tmp/narration-playback.patch
RUN git apply --check /tmp/narration-playback.patch \
    && git apply /tmp/narration-playback.patch

COPY KSZ/patches/weather-api-compat.patch /tmp/weather-api-compat.patch
RUN git apply --check /tmp/weather-api-compat.patch \
    && git apply /tmp/weather-api-compat.patch

COPY KSZ/patches/news-retrieval.patch /tmp/news-retrieval.patch
RUN git apply --check /tmp/news-retrieval.patch \
    && git apply /tmp/news-retrieval.patch
COPY KSZ/patches/prompt-owner.patch /tmp/prompt-owner.patch
RUN git apply --check /tmp/prompt-owner.patch \
    && git apply /tmp/prompt-owner.patch

FROM ghcr.io/xinnan-tech/xiaozhi-esp32-server:server-base

COPY --from=patched-source /src .
COPY KSZ/server/ksz_guide ./ksz_guide
COPY KSZ/shared/ksz_prompt.py ./ksz_prompt.py

CMD ["python", "app.py"]
