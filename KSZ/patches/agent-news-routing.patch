+def _news_search_retry(body: ChatCompletionRequest) -> bool:
+    return (
+        body.tool_choice in (None, "auto")
+        and {"web_search", "yuanbao_search"} & _offered_tool_names(body)
+        and _latest_tool_name(body) == "get_news_from_newsnow"
+        and _message_content_text(body.messages[-1].content).startswith("未配置新闻来源或类别：")
+        and not re.search(r"来源|来自|只用|只要|source|from", _latest_user_text(body), re.IGNORECASE)
+    )
+
+
+def _keeps_web_search(body: ChatCompletionRequest, tool_result_turn: bool = False) -> bool:
+    if body.tool_choice == "none":
+        return False
+    context = getattr(body, "ksz_prompt_context", None) or {}
+    if isinstance(context, dict) and context.get("turn", {}).get("tool_depth_exhausted"):
+        return False
+    if tool_result_turn and not _news_search_retry(body):
+        return False
+    names = _offered_tool_names(body)
+    if not names & {"web_search", "yuanbao_search"}:
+        return False
+    question = _latest_user_text(body)
+    if visual_intent(question) in {"capture", "identity"}:
+        return False
+    return not any(
+        category in {"greeting", "identity", "identity_story", "thanks", "goodbye", "smalltalk"}
+        and pattern.search(question)
+        for category, pattern in _DIRECT_INTENT_PATTERNS
+    )
+
+
+def _is_real_search(body: ChatCompletionRequest) -> bool:
+    if body.tool_choice == "none" or "yuanbao_search" not in _offered_tool_names(body):
+        return False
+    if _news_search_retry(body):
+        return True
+    question = _latest_user_text(body)
+    return any(
+        category == "search" and intent_pattern.search(question)
+        for category, intent_pattern, _tool_pattern in _TOOL_INTENT_PATTERNS
+    )
 
 
