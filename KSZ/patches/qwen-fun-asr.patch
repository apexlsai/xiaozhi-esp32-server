+    def _audio_data_uri(self, artifacts) -> str:
+        audio_bytes = b""
+        if artifacts.temp_path:
+            audio_bytes = Path(artifacts.temp_path).read_bytes()
+        if not audio_bytes and artifacts.pcm_bytes:
+            audio_bytes = self._pcm_to_wav(artifacts.pcm_bytes)
