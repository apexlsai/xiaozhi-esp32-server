+    @classmethod
+    def _normalize_api_url(cls, value: Optional[str]) -> str:
+        url = (value or cls.default_url).strip().rstrip("/")
+        if url.endswith("/generation"):
+            return url
+        if url.endswith("/multimodal-generation"):
+            return f"{url}/generation"
+        if url.endswith("/api/v1"):
+            return f"{url}{cls.service_path}"
+        if url.endswith("/compatible-mode/v1"):
+            return f"{url[:-len('/compatible-mode/v1')]}/api/v1{cls.service_path}"
+        if url.endswith("/v1"):
+            return f"{url[:-len('/v1')]}/api/v1{cls.service_path}"
+        return url
